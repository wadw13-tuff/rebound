DATABASE_URL="postgresql://user:password@host:5432/rebound?sslmode=require"
# Optional: the app uses deterministic explanations and approved swaps without this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VERSION=2023-06-01
# Set only if the Anthropic key is not workspace-scoped.
ANTHROPIC_WORKSPACE_ID=
# Public HTTPS Preview needs true; use false for plain-http local development.
COOKIE_SECURE=true
# Lemon Squeezy store/API values. Keep the API key and webhook secret server-only.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Public production URL used only when a browser Origin header is unavailable.
APP_URL=https://reboundworkoutapp.co.uk
